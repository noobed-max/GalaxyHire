# Copy to .env and adjust. Nothing secret is committed.
RUN_ROLE=api

# Docker Compose publishes Postgres on host port 5433 (the container remains on 5432).
DATABASE_URL=postgresql+asyncpg://galaxy:galaxy@localhost:5433/galaxy
REDIS_URL=redis://localhost:6379/0
OBJECT_STORE_DIR=./data/objects
# the Apply flow writes each job's tailored resume PDF here
RESUME_OUTPUT_DIR=./data/resumes

INGEST_HOURS_SEED=72
SOURCE_CIRCUIT_BREAK_AFTER=5
PROXY_POOL=

# optional bring-your-own OpenAI-compatible endpoint (llama.cpp / Ollama / other compatible servers)
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=not-needed
LLM_MODEL=

EMBEDDING_VERSION=minilm-l6-v2
EMBEDDING_DIM=384

# csv of accepted x-api-key values
API_KEYS=dev-key
